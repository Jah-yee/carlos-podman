#
# Alert-channel MIRROR for instance '{{ carlos_instance }}' — root:root 0600.
# carlos-ctl reads these three keys as a FALLBACK when the resolved value from
# carlos-app.env is empty (unreadable/unmounted $EMR_HOME included): the env
# file lives on the very volume whose failure-to-mount is the highest-severity
# condition the boot guard pages about, and without this mirror that page was
# journal-only. Playbook-owned (re-rendered every run); the webhook/heartbeat
# values are bearer-capability URLs, which is why this is a separate 0600 file
# and NOT part of the 0644 registry entry next to it.
ALERT_WEBHOOK={{ carlos_alert_webhook }}
ALERT_EMAIL={{ carlos_alert_email }}
HEARTBEAT_URL={{ carlos_heartbeat_url }}
