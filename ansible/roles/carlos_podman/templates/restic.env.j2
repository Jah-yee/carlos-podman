# restic credentials + backend for the carlos-app backup — rendered by
# the carlos-podman Ansible role into $EMR_HOME/container/conf/restic/restic.env
# (mode 600) and consumed by `carlos-ctl backup` / the restic container.
#
# !!! Copy RESTIC_PASSWORD somewhere safe OFF this host. Losing it makes
# !!! every backup permanently unreadable; this file alone dies with the
# !!! host it is meant to protect.

RESTIC_REPOSITORY={{ carlos_restic_repository }}
{# carlos_restic_password_effective is the render task's derived value: the
   operator-set password when given, else a freshly generated 32-char one.
   `mandatory` (NOT a default() to the raw carlos_restic_password, whose
   documented default is ''): this file renders ONCE and is guarded against
   regeneration, so a silent empty-password render would be PERMANENT — the
   render must fail loudly instead if the derivation ever goes missing. #}
RESTIC_PASSWORD={{ carlos_restic_password_effective | mandatory('carlos_restic_password_effective was not derived — the restic render task must set it (a blank RESTIC_PASSWORD would be permanent)') }}

# The default repository above is a LOCAL path — fine as a first tier, but
# a backup that lives on the machine it protects is not disaster recovery.
# Point RESTIC_REPOSITORY at an offsite backend and add its credentials:
#RESTIC_REPOSITORY=s3:https://s3.example.com/carlos-backup
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#RESTIC_REPOSITORY=rest:https://user:password@backup-host:8000/carlos

# Optional overrides (defaults live in `carlos-ctl backup`):
#RESTIC_IMAGE=docker.io/restic/restic:0.19.0
#BACKUP_KEEP=--keep-daily 7 --keep-weekly 5 --keep-monthly 12
# Binlog snapshots only matter within reach of a full dump anchor:
#BACKUP_KEEP_BINLOG=--keep-within 9d
# 15-minute document snapshots close the intra-day RPO gap; the nightly
# `files` tier carries the long horizon, so a short window suffices:
#BACKUP_KEEP_DOCS=--keep-within 3d
# Weekly full pack-data verification (catches bit rot a plain `restic check`
# misses): on this ISO day-of-week (1=Mon .. 7=Sun) the nightly check reads
# ALL pack data. 0 = structural check only.
#CHECK_READ_DATA_DOW=7
# Restore-drill scratch space: the weekly drill loads the dump into a RAM
# tmpfs, so this MUST exceed the restored database size or the drill fails
# every week. A database larger than host RAM needs a disk-backed drill.
#VERIFY_TMPFS_SIZE=4g
#VERIFY_MEM_LIMIT=
