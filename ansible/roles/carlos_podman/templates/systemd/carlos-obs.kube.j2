# Quadlet unit for the {{ carlos_obs_pod }} pod — a ROOTLESS USER unit installed by
# the carlos-podman Ansible role to /etc/containers/systemd/users/<uid>/{{ carlos_obs_pod }}.kube, from
# which the service user's `systemd --user` generates {{ carlos_obs_pod }}.service. Holds
# the log + metric stores, the journald log collector, and the authenticated
# log view. Started before the app pod so the stores/collector lead; it keeps
# running while the app pod is replaced.
#
# No OnFailure={{ carlos_instance }}-alert@ — a user unit cannot trigger a system template
# (the monitor's 15-min systemctl --user is-active check covers pod failure).
[Unit]
Description=CARLOS EMR observability pod (log + metric stores, log view)
# network-online.target rarely exists in a `systemd --user` manager; when it
# is absent these two lines are inert (missing Wants=/After= are ignored). A
# boot race against interface/IP assignment is absorbed by Restart=on-failure.
Wants=network-online.target
After=network-online.target
# Never give up permanently (StartLimitIntervalSec=0 disables the start-rate
# limiter): a transient fault (network race, slow disk, OOM recovery) that
# outlasts a burst budget would otherwise leave the EMR PERMANENTLY stopped
# until a human intervenes, and the 15-min monitor sweep is the only detector.
# RestartSec=30 below still paces the retries, so a genuine config error
# (e.g. the documented innodb_page_size mismatch) loops calmly at 2/min
# instead of thrashing.
StartLimitIntervalSec=0

[Kube]
Yaml={{ carlos_emr_home }}/container/{{ carlos_obs_pod }}.yaml
# Shared network so the app pod's vmagent can remote-write here by pod name
# ({{ carlos_obs_pod }}:8428) and on-demand phpMyAdmin can reach the app-pod db.
Network={{ carlos_net_name }}

[Service]
Restart=on-failure
RestartSec=30
# First start pulls the victorialogs/victoria-metrics/vector/caddy images.
TimeoutStartSec=900

[Install]
# User-manager target (multi-user.target does not exist in `systemd --user`).
WantedBy=default.target
